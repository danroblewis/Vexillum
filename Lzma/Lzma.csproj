<Project Sdk="Microsoft.NET.Sdk">
  <!-- Vendored LZMA SDK (7-Zip). Sources untouched; only this project file is ours. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>Lzma</AssemblyName>
    <RootNamespace>SevenZip</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- LzmaAlone is the standalone command-line tool (second Main, designer files); not part of the library. -->
    <Compile Remove="Compress/LzmaAlone/**" />
    <None Remove="Compress/LzmaAlone/**" />
  </ItemGroup>
</Project>
