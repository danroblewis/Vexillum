<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared client+server library. All .cs files in this tree are the author's
       original sources and compile unchanged; missing libraries come from Shims/. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>Game</AssemblyName>
    <RootNamespace>Vexillum</RootNamespace>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" />
    <!-- MiscUtil (Jon Skeet): EndianBinaryReader/Writer + EndianBitConverter used by the netcode. -->
    <PackageReference Include="JTForks.MiscUtil" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Shims/Lzma/Lzma.csproj" />
    <ProjectReference Include="../../Platform/PlatformWindows.csproj" />
    <ProjectReference Include="../../Shims/XnaCompat/XnaCompat.csproj" />
    <ProjectReference Include="../../Shims/MasterServer/MasterServer.csproj" />
    <ProjectReference Include="../../Shims/Drawing/Drawing.csproj" />
    <ProjectReference Include="../../Shims/Steamworks/Steamworks.csproj" />
    <ProjectReference Include="../../Shims/WinForms/WinForms.csproj" />
    <ProjectReference Include="../../Shims/Nuclex/Nuclex.csproj" />
  </ItemGroup>
</Project>
