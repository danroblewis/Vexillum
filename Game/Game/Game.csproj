<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared client+server library. All .cs files in this tree are the author's
       original sources and compile unchanged; missing libraries come from Shims/. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>Game</AssemblyName>
    <RootNamespace>Vexillum</RootNamespace>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- Vendored MiscUtil (Jon Skeet) file that overrides MarshalByRefObject.CreateObjRef,
         a .NET Framework remoting API absent from .NET 9. Nothing in Vexillum uses
         NonClosingStreamWrapper, and CLAUDE.md rule 20 allows only project-file changes
         to vendored code, so it is left out of the compile instead of edited. -->
    <Compile Remove="util/misc/IO/NonClosingStreamWrapper.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="$(MonoGameVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Lzma/Lzma.csproj" />
    <ProjectReference Include="../../Platform/PlatformWindows.csproj" />
    <ProjectReference Include="../../Shims/XnaCompat/XnaCompat.csproj" />
    <ProjectReference Include="../../Shims/MasterServer/MasterServer.csproj" />
    <ProjectReference Include="../../Shims/Drawing/Drawing.csproj" />
    <ProjectReference Include="../../Shims/Steamworks/Steamworks.csproj" />
    <ProjectReference Include="../../Shims/WinForms/WinForms.csproj" />
    <ProjectReference Include="../../Shims/Nuclex/Nuclex.csproj" />
  </ItemGroup>
</Project>
