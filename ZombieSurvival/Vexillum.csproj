<Project Sdk="Microsoft.NET.Sdk">
  <!-- Client entry point (assembly VexillumGame). Program.cs is wrapped in
       "#if WINDOWS || XBOX" by the author, so WINDOWS is defined here; it is
       the author's constant, not a platform switch. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>VexillumGame</AssemblyName>
    <RootNamespace>Vexillum</RootNamespace>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <!-- PortProgram.cs parses the root/connect arguments and then calls the
         author's Program.Main unchanged (docs/PORTING.md step 7). -->
    <StartupObject>Vexillum.PortProgram</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Game/Game/Game.csproj" />
    <ProjectReference Include="../Shims/XnaCompat/XnaCompat.csproj" />
    <ProjectReference Include="../Shims/Drawing/Drawing.csproj" />
    <ProjectReference Include="../Shims/Steamworks/Steamworks.csproj" />
    <ProjectReference Include="../Shims/WinForms/WinForms.csproj" />
    <ProjectReference Include="../Shims/Nuclex/Nuclex.csproj" />
    <ProjectReference Include="../Shims/DebugHost/DebugHost.csproj" />
  </ItemGroup>
</Project>
