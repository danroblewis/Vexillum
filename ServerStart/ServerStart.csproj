<Project Sdk="Microsoft.NET.Sdk">
  <!-- WinForms launcher for the dedicated server. Not in Vexillum.sln: its
       Designer code needs Form/Button/TextBox/ComponentResourceManager, which
       the System.Windows.Forms shim does not provide (docs/PORTING.md step 7/9). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>VexillumServerStart</AssemblyName>
    <RootNamespace>ServerStart</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Game/Game/Game.csproj" />
    <ProjectReference Include="../Shims/Drawing/Drawing.csproj" />
    <ProjectReference Include="../Shims/WinForms/WinForms.csproj" />
  </ItemGroup>
</Project>
