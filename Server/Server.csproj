<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>VexillumServer</AssemblyName>
    <RootNamespace>Server</RootNamespace>
    <!-- PortProgram.cs parses the root/port arguments and then calls the
         author's Program.Main unchanged (docs/PORTING.md steps 7 and 9). -->
    <StartupObject>Server.PortProgram</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="$(MonoGameVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Game/Game/Game.csproj" />
    <ProjectReference Include="../Shims/XnaCompat/XnaCompat.csproj" />
    <ProjectReference Include="../Shims/Drawing/Drawing.csproj" />
    <ProjectReference Include="../Shims/Steamworks/Steamworks.csproj" />
    <ProjectReference Include="../Shims/WinForms/WinForms.csproj" />
    <ProjectReference Include="../Shims/Nuclex/Nuclex.csproj" />
    <ProjectReference Include="../Shims/DebugHost/DebugHost.csproj" />
  </ItemGroup>
</Project>
